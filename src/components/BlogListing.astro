---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
    animated?: boolean;
    excludeIds?: string[];
}

const { animated = false, excludeIds = [] } = Astro.props;
const posts = (await getCollection('blog'))
    .filter((post) => !excludeIds.includes(post.id))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<section
    class:list={['post-listing', { 'post-listing--reveal': animated }]}
    aria-label="Blog posts"
>
    <ul>
        {
            posts.map((post) => (
                <li>
                    <a href={`/blog/${post.id}/`}>
                        {post.data.heroImage && (
                            <Image width={720} height={360} src={post.data.heroImage} alt="" />
                        )}
                        <h4 class="title">{post.data.title}</h4>
                        <p class="date">
                            <FormattedDate date={post.data.pubDate} />
                        </p>
                    </a>
                </li>
            ))
        }
    </ul>
</section>

<style>
    .post-listing {
        max-width: 960px;
        margin: 0 auto;
    }
    ul {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2.5rem 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
    }
    ul li {
        display: flex;
        flex-direction: column;
    }
    ul li * {
        text-decoration: none;
        transition: 0.2s ease;
    }
    ul li img {
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        margin-bottom: 0.75rem;
        border-radius: 12px;
    }
    ul li a {
        display: block;
    }
    .title {
        margin: 0 0 0.25rem 0;
        font-size: 1.35rem;
        color: rgb(var(--black));
        line-height: 1.3;
    }
    .date {
        margin: 0;
        color: rgb(var(--gray));
        font-size: 0.9rem;
    }
    ul li a:hover h4,
    ul li a:hover .date {
        color: rgb(var(--accent));
    }
    ul a:hover img {
        box-shadow: var(--box-shadow);
    }
    @media (max-width: 720px) {
        ul {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }
    @media (prefers-reduced-motion: no-preference) {
        @supports (animation-timeline: view()) {
            .post-listing--reveal li {
                animation: post-enter linear both;
                animation-timeline: view(block);
                animation-range: entry 0% entry 85%;
            }

            @keyframes post-enter {
                from {
                    opacity: 0;
                    filter: blur(8px);
                    transform: translateY(3rem) scale(0.97);
                }
                to {
                    opacity: 1;
                    filter: blur(0);
                    transform: translateY(0);
                }
            }
        }
    }
</style>